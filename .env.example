# Copiez ce fichier en .env et remplissez-le (voir server/README.md).

# Adresse publique du site (https en production : les cookies de session deviennent « Secure »)
PUBLIC_URL=https://animots.example.com
PORT=8080
# 1 si le serveur est derrière un proxy (Nginx, Caddy, Render…), pour la limite d'essais par adresse IP
TRUST_PROXY=1
# Dossier des données (base SQLite + vidéos partagées) : à sauvegarder
DATA_DIR=./data
# Le quota gratuit repart à minuit dans ce fuseau
TIME_ZONE=Europe/Berlin

# Stripe (abonnements) — clés et prix mensuels créés dans le tableau de bord Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLUS=price_...      # Premium 5 €/mois (avec pub)
STRIPE_PRICE_PRO=price_...       # Premium sans pub 10 €/mois
# Test uniquement : 1 = les offres s'activent sans paiement
DEV_BILLING=0

# Publicité Google AdSense (offres Gratuit et Premium 5 €)
ADSENSE_CLIENT=ca-pub-...
ADSENSE_SLOT=1234567890

# E-mails (mot de passe oublié) via Resend
RESEND_API_KEY=re_...
MAIL_FROM=Animots <no-reply@example.com>

# Taille maximale d'une vidéo partagée (Mo)
MAX_UPLOAD_MB_FREE=40
MAX_UPLOAD_MB_PAID=400

# Mentions légales (Impressum), confidentialité, conditions
OPERATOR_NAME=Prénom Nom
OPERATOR_ADDRESS=Rue, code postal, ville, pays
OPERATOR_EMAIL=contact@example.com
OPERATOR_VAT=
