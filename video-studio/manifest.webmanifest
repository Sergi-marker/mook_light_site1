{
  "id": "./",
  "name": "Animots — vos mots prennent vie",
  "short_name": "Animots",
  "description": "Collez un texte : il devient une vidéo animée avec un personnage pictogramme, des sous-titres, une voix et une musique. Pour TikTok, Reels, Shorts et YouTube.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b0c1d",
  "theme_color": "#0b0c1d",
  "categories": ["photo", "productivity", "entertainment"],
  "icons": [
    { "src": "img/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "img/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "img/screenshot-phone.jpg", "sizes": "1080x1920", "type": "image/jpeg", "form_factor": "narrow", "label": "Une phrase devient une scène animée" },
    { "src": "img/screenshot-wide.jpg", "sizes": "1920x1080", "type": "image/jpeg", "form_factor": "wide", "label": "L'éditeur Animots sur ordinateur" }
  ]
